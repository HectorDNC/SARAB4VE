PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sara

# Cloudflare R2 (almacenamiento de audio para reportes por voz)
R2_ENDPOINT=https://<tu-account-id>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=<tu-access-key-id>
R2_SECRET_ACCESS_KEY=<tu-secret-access-key>
R2_BUCKET=sara-audio
R2_PUBLIC_URL=https://pub-<hash>.r2.dev

# Google AI Studio / Gemini — Transcripción de audio + extracción estructurada
# Obtén tu API key gratis en https://aistudio.google.com/apikey
# Gemini se usa en cascada para:
#   - Transcripción de audio (Nivel 1): envía el audio (webm, mp4, wav,
#     ogg, mp3, etc.) como inline data y devuelve transcript + JSON de
#     clasificación. Si Gemini falla, el registro se guarda con
#     transcript_method='ninguno' para revisión manual.
#   - Clasificación de texto (Nivel 1B): si el cliente ya envió el
#     transcript, Gemini lo clasifica (tipo, severidad, etc.). Si falla,
#     cae a Groq → diccionario de palabras clave.
GEMINI_API_KEY=
# Modelo a usar (opcional, default: gemini-1.5-flash — soporta audio inline
# y es rápido/económico)
GEMINI_MODEL=gemini-1.5-flash

# Groq — Fallback de clasificación de texto vía LLM gratuito
# Obtén tu API key gratis en https://console.groq.com
# El sistema funciona igual sin ella (usa fallback por diccionario de palabras clave)
GROQ_API_KEY=
# Modelo a usar (opcional, default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile
